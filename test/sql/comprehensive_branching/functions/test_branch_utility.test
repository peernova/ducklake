# name: test/sql/comprehensive_branching/functions/test_branch_utility.test
# description: Test branch utility functions - list, count, lineage, search
# group: [functions]

require ducklake

require parquet

# Setup: Create DuckLake catalog
statement ok
ATTACH 'ducklake:__TEST_DIR__/branch_utility_test.db' AS db (DATA_PATH '__TEST_DIR__/branch_utility_data');

statement ok
USE db;

# Create a table to work with
statement ok
CREATE TABLE test_table (id INT, value VARCHAR);

statement ok
INSERT INTO test_table VALUES (1, 'a'), (2, 'b'), (3, 'c');

# ============================================================================
# TEST 1: ducklake_branches - list all branches
# ============================================================================

# Initially only main branch exists
query IT
SELECT branch_id, branch_name FROM ducklake_branches('db') ORDER BY branch_id;
----
0	main

# ============================================================================
# TEST 2: ducklake_branch_count - count branches
# ============================================================================

query I
SELECT count FROM ducklake_branch_count('db');
----
1

# ============================================================================
# TEST 3: ducklake_current_branch - get current branch
# ============================================================================

query T
SELECT branch_name FROM ducklake_current_branch('db');
----
main

# ============================================================================
# TEST 4: Create branches and verify list/count
# ============================================================================

statement ok
SELECT * FROM ducklake_create_branch('db', 'feature_a');

statement ok
SELECT * FROM ducklake_create_branch('db', 'feature_b');

statement ok
SELECT * FROM ducklake_use_branch('db', 'feature_a');

statement ok
SELECT * FROM ducklake_create_branch('db', 'feature_a_child');

# Should now have 4 branches
query I
SELECT count FROM ducklake_branch_count('db');
----
4

query T
SELECT branch_name FROM ducklake_branches('db') ORDER BY branch_name;
----
feature_a
feature_a_child
feature_b
main

# ============================================================================
# TEST 5: ducklake_current_branch after switching
# ============================================================================

statement ok
SELECT * FROM ducklake_use_branch('db', 'feature_b');

query T
SELECT branch_name FROM ducklake_current_branch('db');
----
feature_b

statement ok
SELECT * FROM ducklake_use_branch('db', 'main');

query T
SELECT branch_name FROM ducklake_current_branch('db');
----
main

# ============================================================================
# TEST 6: ducklake_branch_lineage - verify lineage
# ============================================================================

# main branch lineage (only itself)
query I
SELECT ancestor_branch_id FROM ducklake_branch_lineage('db', 'main') ORDER BY ancestor_branch_id;
----
0

# feature_a lineage (main -> feature_a)
query I
SELECT ancestor_branch_id FROM ducklake_branch_lineage('db', 'feature_a') ORDER BY ancestor_branch_id;
----
0
1

# feature_a_child lineage (main -> feature_a -> feature_a_child)
query I
SELECT ancestor_branch_id FROM ducklake_branch_lineage('db', 'feature_a_child') ORDER BY ancestor_branch_id;
----
0
1
3

# ============================================================================
# TEST 7: ducklake_search_branches - search by name pattern
# ============================================================================

query T
SELECT branch_name FROM ducklake_search_branches('db', 'feature%') ORDER BY branch_name;
----
feature_a
feature_a_child
feature_b

query T
SELECT branch_name FROM ducklake_search_branches('db', '%child%') ORDER BY branch_name;
----
feature_a_child

query T
SELECT branch_name FROM ducklake_search_branches('db', 'main') ORDER BY branch_name;
----
main

# ============================================================================
# TEST 8: ducklake_branches_by_status - filter by status
# ============================================================================

query T
SELECT branch_name FROM ducklake_branches_by_status('db', 'active') ORDER BY branch_name;
----
feature_a
feature_a_child
feature_b
main

# ============================================================================
# TEST 9: ducklake_delete_branch and verify count
# ============================================================================

statement ok
SELECT * FROM ducklake_delete_branch('db', 'feature_b');

# Count of active branches should be 3 (deleted branches are excluded)
query I
SELECT count FROM ducklake_branch_count('db', 'active');
----
3

# Deleted branch should not appear in list
query T
SELECT branch_name FROM ducklake_branches('db') ORDER BY branch_name;
----
feature_a
feature_a_child
main

# ============================================================================
# TEST 10: ducklake_branch_count with status filter
# ============================================================================

query I
SELECT count FROM ducklake_branch_count('db', 'active');
----
3

    WHERE branch_id = 0
    ORDER BY snapshot_id DESC
    LIMIT 1
) own ON true
LEFT JOIN {METADATA_CATALOG}.ducklake_snapshot parent 
    ON parent.branch_id = b.parent_branch_id AND parent.snapshot_id = b.fork_snapshot_id
WHERE b.branch_id = 0;


# Build directories and cache files
build/
build-repos/
artifacts/

# CMake cache files that cause path conflicts
**/CMakeCache.txt
**/cmake_install.cmake
**/CMakeFiles/
**/*.ninja
**/.ninja_deps
**/.ninja_log

# Git directories (except main .git for submodules)
**/.git
!.git

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
log
logg.log
error.log
output.log
colored_output.txt

# Test databases and files
*.ducklake
*.ducklake.files/
*.ducklake.wal
test*.sql
interactive_test*

# Temporary files
*.tmp
*.temp
2

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*.yml